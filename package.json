{
  "name": "vite-ssr-components",
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "test": "vitest",
    "build": "tsdown",
    "watch": "tsdown --watch",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:fix": "eslint --fix 'src/**/*.{ts,tsx}'",
    "format": "prettier --check 'src/**/*.{ts,tsx}'",
    "format:fix": "prettier --write 'src/**/*.{ts,tsx}'",
    "publint": "publint",
    "prerelease": "bun run build && bun vitest --run",
    "release": "np --no-publish"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./common": "./dist/common/index.mjs",
    "./hono": "./dist/hono/index.mjs",
    "./plugin": "./dist/plugin/index.mjs",
    "./react": "./dist/react/index.mjs",
    "./package.json": "./package.json"
  },
  "author": "Yusuke Wada <yusuke@kamawada.com> (https://github.com/yusukebe)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yusukebe/vite-ssr-components.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "devDependencies": {
    "@babel/types": "^7.27.1",
    "@hono/eslint-config": "^2.0.1",
    "@types/babel__traverse": "^7.20.7",
    "@types/node": "^22.15.21",
    "@types/picomatch": "^4.0.0",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9.27.0",
    "hono": "^4.7.10",
    "np": "^10.2.0",
    "prettier": "^3.5.3",
    "publint": "^0.3.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsdown": "^0.23.0",
    "vite": "^8.0.10",
    "vitest": "^3.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@babel/parser": "^7.27.2",
    "@babel/traverse": "^7.27.1",
    "picomatch": "^4.0.2"
  }
}
